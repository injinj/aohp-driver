package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_etc {
    name: "initial-package-stopped-states-aohp.xml",
    src: "initial-package-stopped-states-aohp.xml",
    sub_dir: "sysconfig",
}

// EXECUTE_APP_FUNCTIONS is internal|privileged (Android 16, app_function_access_api_enabled off):
// the platform signature alone cannot grant it, so the Driver is a priv-app with an allowlist.
// The SELinux domain stays platform_app (seinfo=platform wins over isPrivApp).
prebuilt_etc {
    name: "privapp-permissions-aohp-driver.xml",
    src: "privapp-permissions-aohp-driver.xml",
    sub_dir: "permissions",
}

android_app_import {
    name: "AOHPDriver",
    apk: "AOHPDriver.apk",
    certificate: "platform",
    privileged: true,
    required: ["privapp-permissions-aohp-driver.xml"],
}
